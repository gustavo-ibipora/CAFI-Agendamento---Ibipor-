# Banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=farmacia_ibipora
DB_PORT=3306

# Sessao do painel administrativo
# Troque por um texto longo e aleatorio antes de publicar o sistema.
SESSION_SECRET=troque-este-valor-por-um-texto-aleatorio-longo
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Seguranca HTTP
# Em producao, informe o dominio oficial. Exemplo: https://farmacia.ibipora.pr.gov.br
CORS_ORIGIN=
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
AGENDAMENTO_RATE_LIMIT_WINDOW_MS=900000
AGENDAMENTO_RATE_LIMIT_MAX=30

# E-mail de confirmacao
# Deixe SMTP_HOST, SMTP_USER e SMTP_PASS vazios se o envio de e-mail ainda nao estiver configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CAFI <agendamento@ibipora.pr.gov.br>"
EMAIL_WORKER_INTERVAL_MS=30000

# Servidor HTTP
PORT=3000
